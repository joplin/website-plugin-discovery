<a
	href="plugin/{{id}}/"
	id="plugin-card-{{id}}"
	class="col-md-12 gx-3 mb-3 card plugin-link-card"

	{{! Data used for changing the sort order with JavaScript }}
	data-sort-title="{{name}}"
	data-sort-updated="{{timeModified}}"
>
	<div class="promo-tile-wrapper">
		<svg class="orbit-circle" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<circle cx="50" cy="50" r="37.8" fill="none" stroke="#D9E8F8" stroke-width="0.84" stroke-dasharray="4.6 4.6"/>
		</svg>
		<img src="{{assets.promoTile.src}}" class="card-img-top promo-tile {{assets.promoTile.extraClassNames}}" alt=""/>
		<span class="orbit-icon orbit-icon--top-left">
			<svg viewBox="68 7 23 23" width="100%" height="100%" aria-hidden="true">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M78.175 15.1448C77.9601 14.9229 77.8255 14.6223 77.8192 14.2891C77.8059 13.5906 78.3614 13.0135 79.0599 13.0002C79.7585 12.9869 80.3355 13.5424 80.3488 14.241C80.3555 14.5914 80.219 14.9113 79.993 15.1448H84.0299V18.5574C84.247 18.3656 84.5306 18.247 84.8429 18.2411C85.5414 18.2278 86.1185 18.7833 86.1318 19.4818C86.1451 20.1803 85.5896 20.7574 84.8911 20.7707C84.5615 20.777 84.2589 20.6566 84.0299 20.4543V24H80.139C80.2763 23.7932 80.3543 23.5439 80.3493 23.2769C80.336 22.5784 79.7589 22.0229 79.0604 22.0362C78.3618 22.0495 77.8063 22.6266 77.8196 23.3251C77.8244 23.5748 77.9012 23.8063 78.0299 24H74V20.5271C74.2157 20.685 74.4829 20.7762 74.7708 20.7707C75.4693 20.7574 76.0248 20.1803 76.0115 19.4818C75.9982 18.7833 75.4212 18.2278 74.7227 18.2411C74.4521 18.2462 74.2029 18.336 74 18.4846V15.1448H78.175Z" fill="currentColor"/>
			</svg>
		</span>
		<span class="orbit-icon orbit-icon--right">
			<svg viewBox="162 72 23 23" width="100%" height="100%" aria-hidden="true">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M178 79L178 87.2511L169.985 87.2511L169.985 83.8904C169.78 84.0904 169.491 84.2176 169.167 84.2232C168.535 84.2341 168.012 83.7771 168 83.2025C167.988 82.6279 168.491 82.1531 169.123 82.1422C169.463 82.1363 169.77 82.2653 169.985 82.4749L169.985 79L173.128 79C172.985 79.1774 172.903 79.3973 172.908 79.6341C172.92 80.2087 173.442 80.6657 174.074 80.6548C174.707 80.6438 175.209 80.1691 175.197 79.5945C175.193 79.3719 175.111 79.1669 174.977 79L178 79Z" fill="currentColor"/>
				<ellipse cx="1.14503" cy="1.04072" rx="1.14503" ry="1.04072" transform="matrix(-0.99985 0.0173015 -0.020945 -0.999781 175.219 88.9604)" fill="currentColor"/>
			</svg>
		</span>
		<span class="orbit-icon orbit-icon--bottom-left">
			<svg viewBox="51 109 23 23" width="100%" height="100%" aria-hidden="true">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M64.9067 121.26C64.8925 120.672 65.4844 120.186 66.2287 120.175C66.7462 120.167 67.2011 120.391 67.4351 120.726L67.4351 116.958L63.5236 116.958C63.8999 116.764 64.1452 116.426 64.136 116.045C64.1219 115.457 63.507 114.989 62.7627 115C62.0185 115.011 61.4266 115.497 61.4408 116.086C61.4496 116.452 61.6918 116.772 62.0533 116.958L58 116.958L58 125.404L67.4351 125.404L67.4351 121.754C67.2099 122.076 66.7792 122.297 66.28 122.305C65.5357 122.316 64.9209 121.848 64.9067 121.26Z" fill="currentColor"/>
			</svg>
		</span>
	</div>
	<div class="card-body {{domId}}">
		<div class="plugin-header text-wrap">
			<label for="plugin-card-{{id}}" class="plugin-title">
				{{ name }}
			</label>

			{{#_recommended}}
				<span
					class="plugin-recommended-circle"
					aria-label="Recommended"

					data-bs-toggle="tooltip"
					data-bs-title="Recommended: The Joplin team trusts the developer(s) of this plugin."
				><i class="fas fa-crown"></i></span>
			{{/_recommended}}
		</div>

		<p class="plugin-description">
			{{ description }}
		</p>
	</div>
</a>